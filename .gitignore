# Claude Code - sensitive and runtime data
.claude/
.antigravitycli/
claude-code/.credentials.json
claude-code/history.jsonl
claude-code/cache/
claude-code/logs/
claude-code/file-history/
claude-code/debug/
claude-code/backups/
# claude-code/agents/ は dotfiles 管理対象（symlink 元）
claude-code/.superclaude-metadata.json

# Skills - sensitive and generated files
claude-code/skills/**/.env
claude-code/skills/**/__pycache__/

# Codex - sensitive and runtime data
.codex/
codex/config.local.toml
codex/*.local.toml
codex/**/*.local.toml


# Sensitive authentication files (global)
**/auth-profiles.json
**/*.credentials.json
**/oauth-tokens.json

# Nix
result
result-*

# linux-builder の SSH 鍵
# create-builder / add-keys は鍵置き場を `./keys` と cwd 基準で解決するため、
# リポジトリ内で linux-builder-start を手実行すると秘密鍵がここに落ちる。
# 正規の置き場は /var/lib/linux-builder/keys（launchd の WorkingDirectory）。
/keys/
**/builder_ed25519
**/builder_ed25519.pub

# macOS
.DS_Store

# no sleep marker
.no-sleep-server
