#!/usr/bin/env bash
# push 前に CI（.github/workflows/ci.yml）と同じ検査を走らせる: フォーマット + 全テスト。
# 検査対象は作業ツリー（未 commit の変更も含む）。急ぎで飛ばすなら git push --no-verify。
set -euo pipefail

# ブランチ削除だけの push では検査しない
pushes_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) pushes_commits=1 ;;
  esac
done
[ "$pushes_commits" -eq 1 ] || exit 0

echo "pre-push: nix flake check（フォーマット）"
nix flake check

# devShell は TMPDIR を $TMPDIR/nix-shell.* に付け替える。Claude の sandbox が Unix socket を許すのは
# $TMPDIR/sock だけなので、外側の TMPDIR のまま走らせる（CI・人間の実行でも結果は変わらない）
echo "pre-push: tests/run-all.sh"
nix develop --command env TMPDIR="${TMPDIR:-/tmp}" tests/run-all.sh
