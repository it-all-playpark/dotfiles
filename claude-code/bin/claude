#!/usr/bin/env bash
# claude: Claude Code 本体の上流 proxy を agent-vault に向けてから実体を exec する wrapper
#
# sandbox 内の git / gh は Claude Code の proxy（allowedDomains で通信先を確認）→ HTTPS_PROXY の
# agent-vault（owner ごとの PAT を付与）→ GitHub の順に流れ、sandbox 内には資格情報を持ち込まない。
# HTTPS_PROXY は本体の env に要るが、そこに入る proxy token は git 管理の settings.json に置けないので、
# 起動時にここで token ファイル（~/.agent-vault 配下。sandbox からは denyRead）を読んで組み立てる。
# bg job を動かす daemon は on-demand で claude から起動されるので、この env を継承する。
# sandbox 内のコマンドの HTTPS_PROXY は Claude Code 自身の proxy に置き換わり、token は見えない。
# desktop app / IDE から起動した claude と、この wrapper を通らずに立った daemon には env が付かない。
#
# 付ける env（agent-vault が使えるときだけ）:
#   HTTPS_PROXY / HTTP_PROXY   http://<proxy token>:<vault>@127.0.0.1:<port>
#   NO_PROXY                   loopback（agent-vault は private range へ転送しない）
#   NODE_EXTRA_CA_CERTS / SSL_CERT_FILE / GIT_SSL_CAINFO
#                              agent-vault の CA を足した bundle（agent-vault-server.sh が書く）
#   CLAUDE_GH_VAULT=1          account-exec（gh の shim）への目印。gh は cwd のアカウントの placeholder 入り
#                              config dir（~/.config/agent-vault-gh/<account>）を使い、agent-vault が
#                              placeholder を本物の token に置き換える。bg job も daemon 経由でこの env を継承する
#
# 本体の env に AGENT_VAULT_TOKEN を出さない（agent-vault CLI がそれで管理 API に認証し、
# sandbox 内から credential を読めてしまう）。
#
# 環境変数（テスト・一時上書き用）:
#   AGENT_VAULT_PROXY_TOKEN_FILE  既定 $HOME/.agent-vault/proxy-token
#   AGENT_VAULT_CA_BUNDLE         既定 $HOME/.local/state/agent-vault/ca-bundle.pem
#   AGENT_VAULT_PROXY_PORT        既定 14322
#   AGENT_VAULT_VAULT             既定 default
#
# fail-open: HTTPS_PROXY が既にある（sandbox 内から呼んだ claude・明示指定）/ token ファイルが無い
# ときは env を付けずに実体を exec する。token はあるが CA bundle が無い・proxy port が閉じている
# （agent-vault が落ちている）ときも同じで、stderr に 1 行警告する。
set -euo pipefail

warn() {
  echo "claude (agent-vault wrapper): $*" >&2
}

token_file="${AGENT_VAULT_PROXY_TOKEN_FILE:-$HOME/.agent-vault/proxy-token}"
ca_bundle="${AGENT_VAULT_CA_BUNDLE:-$HOME/.local/state/agent-vault/ca-bundle.pem}"
port="${AGENT_VAULT_PROXY_PORT:-14322}"
vault="${AGENT_VAULT_VAULT:-default}"

if [ -z "${HTTPS_PROXY:-}" ] && [ -r "$token_file" ]; then
  token="$(tr -d '[:space:]' <"$token_file")"
  if [ -z "$token" ]; then
    warn "proxy token file is empty: $token_file; starting without agent-vault"
  elif [ ! -s "$ca_bundle" ]; then
    warn "CA bundle not found: $ca_bundle; starting without agent-vault"
  elif ! (: <>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    warn "agent-vault is not listening on 127.0.0.1:$port; starting without agent-vault"
  else
    proxy="http://$token:$vault@127.0.0.1:$port"
    export HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy"
    export NO_PROXY="localhost,127.0.0.1,::1"
    export NODE_EXTRA_CA_CERTS="$ca_bundle" SSL_CERT_FILE="$ca_bundle" GIT_SSL_CAINFO="$ca_bundle"
    export CLAUDE_GH_VAULT=1
  fi
  unset token proxy
fi

# PATH から shim dir（$HOME/.claude/bin と自身の物理 dir）を除いて実体を解決する
self="$0"
if resolved="$(readlink -f "$0" 2>/dev/null)" && [ -n "$resolved" ]; then
  self="$resolved"
fi
self_dir="$(cd "$(dirname "$self")" && pwd -P)"
shim_dirs=":$HOME/.claude/bin:$self_dir:"
if home_bin_phys="$(cd "$HOME/.claude/bin" 2>/dev/null && pwd -P)"; then
  shim_dirs="$shim_dirs$home_bin_phys:"
fi

lookup_path=""
p_rest="$PATH:"
while [ -n "$p_rest" ]; do
  p="${p_rest%%:*}"
  p_rest="${p_rest#*:}"
  [ -z "$p" ] && continue
  p_phys="$(cd "$p" 2>/dev/null && pwd -P)" || p_phys="$p"
  case "$shim_dirs" in
  *":$p:"* | *":$p_phys:"*) continue ;;
  esac
  lookup_path="${lookup_path:+$lookup_path:}$p"
done

real=""
if [ -n "$lookup_path" ]; then
  real="$(PATH="$lookup_path" command -v claude 2>/dev/null || true)"
fi
if [ -z "$real" ] || [ "$real" -ef "$self" ]; then
  warn "real 'claude' not found in PATH (shim dirs excluded: $HOME/.claude/bin, $self_dir)"
  exit 127
fi

exec "$real" "$@"
