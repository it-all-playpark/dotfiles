#!/usr/bin/env bash
# agent-vault-sync-gh: gh にログイン済みの OAuth token を agent-vault の credential に写す
#
# agent-vault 経由のセッションでは、gh は placeholder の token を送り、agent-vault がそれを vault の
# credential に置き換える（home-manager/home/file/agent-vault/services.yaml）。その credential には、
# 人間の端末で `gh auth login` 済みの token をそのまま使う（新しい PAT は発行しない）。
# `gh auth login` / `gh auth refresh` / token の revoke の後に実行し直す（古いままだと 401 になる）。
#
# 人間の端末で実行する（sandbox 内からは ~/.config/gh* も ~/.agent-vault も読めない）。
# config dir が無いアカウント（そのマシンで使っていないアカウント）は飛ばす。
#
# token は `vault credential set` の argv で渡す（v0.40.0 の CLI は stdin やファイルから値を取れない）。
# 実行中は同じユーザーのプロセスから ps で見えるが、同じユーザーなら `gh auth token` で直接読めるので
# 新しく露出するものは無い。sandbox 内からは ps が使えない（Operation not permitted）。
#
# main（GH_TOKEN_MAIN=~/.config/gh）以外のアカウントは、取引先のアカウント名を含むので private repo の
# agent-vault/sync-gh-accounts に 1 行 1 つ "<credential key>=<gh config dir>" で書く（~/ は $HOME に展開）。
#
# 環境変数:
#   AGENT_VAULT_SYNC_GH_ACCOUNTS       "<credential key>=<gh config dir>" を空白区切り（指定時はこれだけを使う。テスト用）
#   AGENT_VAULT_SYNC_GH_ACCOUNTS_FILE  追加アカウントの一覧
#                                      （既定 ~/ghq/github.com/it-all-playpark/dotfiles-private/agent-vault/sync-gh-accounts）
set -euo pipefail

accounts_file="${AGENT_VAULT_SYNC_GH_ACCOUNTS_FILE:-$HOME/ghq/github.com/it-all-playpark/dotfiles-private/agent-vault/sync-gh-accounts}"
if [ -n "${AGENT_VAULT_SYNC_GH_ACCOUNTS:-}" ]; then
  accounts="$AGENT_VAULT_SYNC_GH_ACCOUNTS"
else
  accounts="GH_TOKEN_MAIN=$HOME/.config/gh"
  if [ -f "$accounts_file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
      "" | "#"*) continue ;;
      esac
      key="${line%%=*}"
      dir="${line#*=}"
      case "$dir" in
      "~/"*) dir="$HOME/${dir#"~/"}" ;;
      esac
      accounts="$accounts $key=$dir"
    done <"$accounts_file"
  fi
fi

args=(GITHUB_GIT_USERNAME=x-access-token)
for pair in $accounts; do
  key="${pair%%=*}"
  dir="${pair#*=}"
  if [ ! -d "$dir" ]; then
    echo "agent-vault-sync-gh: $dir not found; skipping $key" >&2
    continue
  fi
  # GH_CONFIG_DIR を明示するので account-exec（gh の shim）は素通しする
  token="$(GH_CONFIG_DIR="$dir" gh auth token)"
  args+=("$key=$token")
done
unset token

agent-vault vault credential set --vault default "${args[@]}"
echo "agent-vault-sync-gh: set ${#args[@]} credential(s) in vault 'default'" >&2
