#!/usr/bin/env bash
# skills-worktree-add <name>
#
# it-all-playpark/skills の worktree を repo 外の skills-wt/<name> に origin/main から作り、
# 同名の branch を切る。sandbox.excludedCommands に絶対パスで登録して sandbox 外で動かす。
#
# なぜ要るか: skills repo（~/.claude/skills の実体）は sandbox 内から書けず、`git worktree` は
# excludedCommands の `git *` に一致しても sandbox 内で走る（2026-09-23 頃から）。素の git branch /
# commit / push は通るので、worktree の作成だけをこのスクリプトが肩代わりする。
#
# sandbox 外で動くので、できることを「skills-wt 直下に origin/main を展開し、新しい branch を 1 本
# 作る」に絞る:
#   - 対象 repo と作成先は $HOME から固定し、引数では受け取らない
#   - name は 1 個だけ、[a-z0-9][a-z0-9._-]* の 64 字以内、`..` を含まない
#   - 既存のパス・既存の branch は拒否（-B で上書きしない）
#   - 起点は origin/main だけ
#   - GIT_* 環境変数を消し、core.hooksPath=/dev/null で post-checkout などの hook を走らせない
#
# 置き場所の dotfiles/claude-code/bin は settings.json の sandbox.filesystem.denyWrite で
# sandbox 内から書き換えられないようにしてある（書き換えられると sandbox 外への脱出口になる）。

set -euo pipefail

usage() {
  echo "usage: skills-worktree-add <name>   (name: [a-z0-9][a-z0-9._-]*, max 64)" >&2
  exit 2
}

die() {
  echo "skills-worktree-add: $*" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
name="$1"
[[ $name =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || usage
[[ $name != *..* ]] || usage
[[ $name != *.lock ]] || usage

for v in $(compgen -e); do
  case "$v" in
    GIT_*) unset "$v" ;;
  esac
done

repo="$HOME/ghq/github.com/it-all-playpark/skills"
dest="$HOME/ghq/github.com/it-all-playpark/skills-wt/$name"

[[ -d "$repo/.git" ]] || die "repo not found: $repo"
[[ ! -e $dest && ! -L $dest ]] || die "already exists: $dest"
if git -C "$repo" show-ref --verify --quiet "refs/heads/$name"; then
  die "branch already exists: $name"
fi

git -C "$repo" fetch --quiet origin main
git -C "$repo" -c core.hooksPath=/dev/null -c core.fsmonitor=false \
  worktree add --quiet -b "$name" "$dest" origin/main

echo "$dest"
