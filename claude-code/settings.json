  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "gh:*",
      "git:*",
      "~/.claude/skills/*",
      "bash ~/.claude/skills/*",
      "python3 ~/.claude/skills/*",
      "/Users/naramotoyuuji/.claude/skills/*",
      "bash /Users/naramotoyuuji/.claude/skills/*",
      "python3 /Users/naramotoyuuji/.claude/skills/*",
