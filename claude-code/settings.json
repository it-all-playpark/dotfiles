{
  "agentPushNotifEnabled": true,
  "askUserQuestionTimeout": "10m",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "playpark-llc/corporate-site の refs/heads/dev を origin/main の sha から gh api で再作成することは許可する（日次ブログ生産の base ブランチ復旧。作成のみで、削除は含まない）"
    ]
  },
  "dialogExpiry": "10m",
  "editorMode": "vim",
  "effortLevel": "high",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "dev-flow@playpark": true,
    "playpark-core@playpark": true,
    "playpark-skills@playpark": true,
    "playwright@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "vercel@claude-plugins-official": true
  },
  "env": {
    "API_TIMEOUT_MS": "900000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1"
  },
  "extraKnownMarketplaces": {
    "playpark": {
      "source": {
        "repo": "it-all-playpark/skills",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "claude-opus-4-8",
    "claude-sonnet-5"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "args": [
              "-e",
              "display notification \"Claude Code needs your attention\" with title \"Claude Code\""
            ],
            "command": "osascript",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/permission-journal.sh\"",
            "statusMessage": "permission request logging (Jev 分類)...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$HOME/.claude/hooks/memory-monitor.py\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/posttool-injection-screen.sh\"",
            "statusMessage": "外部テキストの injection 検査中...",
            "timeout": 6,
            "type": "command"
          }
        ],
        "matcher": "WebFetch|WebSearch|Bash|Read|mcp__claude_ai_Gmail__get_message|mcp__claude_ai_Gmail__get_thread|mcp__claude_ai_Gmail__search_threads|mcp__claude_ai_Google_Drive__read_file_content|mcp__claude_ai_Google_Drive__download_file_content"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/posttoolfail-classify.sh\"",
            "statusMessage": "失敗種別を Jev で分類中...",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/pre-compact-dump.sh\"",
            "statusMessage": "session 状態を claudedocs/session-*.md に退避中...",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/allow-feature-push.sh\"",
            "if": "Bash(git *)",
            "statusMessage": "push ブランチチェック中...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/pretool-bash-credential-guard.sh\"",
            "statusMessage": "prod credential 検知中...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/pretool-npx-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/pretool-gh-pr-self-approve-guard.sh\"",
            "statusMessage": "PR self-approve チェック中...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/generate-worktreeinclude.sh\"",
            "if": "Bash(git worktree add*)",
            "statusMessage": ".worktreeinclude 自動生成チェック中...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/allow-pr-merge.sh\"",
            "if": "Bash(gh pr merge*)",
            "statusMessage": "PR merge ブランチチェック中...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "Context compacted. Reminder: Read CLAUDE.md for project context. Run git status before making changes."
            ],
            "command": "echo",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.claude/hooks/session-start-replay.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/session-start-replay.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/session-start-replay.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "resume"
      },
      {
        "hooks": [
          {
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/session-start-account-path.sh\"",
            "statusMessage": "~/.claude/bin を PATH に追加中...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/stop-unfinished-guard.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "-c",
              "rm -f \"/tmp/claude-skill-ctx-${CLAUDE_CODE_SESSION_ID:-unknown}\" 2>/dev/null || true"
            ],
            "command": "bash",
            "timeout": 1,
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "ja",
  "permissions": {
    "additionalDirectories": [
